# Supabase (shared Isaly "isaly-apps-prod" project — Plant Care Assistant uses its own
# "plant_care" Postgres schema there, isolated from other apps' tables via RLS + schema).
VITE_SUPABASE_URL=https://vaxghfybiqnyfwpbgzly.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: real weather provider for WeatherService. Leave unset to use the
# built-in mock provider (default in local/dev).
VITE_WEATHER_API_KEY=

# Isaly Feedback Hub (isaly-platform, https://feedback.isaly.se) — server-side
# secrets read by supabase/functions/feedback-hub, NOT VITE_-prefixed so they
# never reach the client bundle. Set with `supabase secrets set`, not here.
# See README.md ("Feedback").
#   FEEDBACK_HUB_URL=https://feedback.isaly.se   (optional, this is the default)
#   FEEDBACK_HUB_API_KEY=                        (required)
